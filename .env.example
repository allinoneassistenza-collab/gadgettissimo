# Percorsi relativi alla cartella del programma.
GADGET_DATA_DIR=data
GADGET_HOST=127.0.0.1
GADGET_PORT=8765
GADGET_SECURE_COOKIE=false
# Per un server PostgreSQL (creare prima il database):
# DATABASE_URL=postgresql+psycopg://utente:password@localhost/gadgettissimo
# Impostare true solo dietro HTTPS. Nessun segreto di default.

# Google Calendar (facoltativo): credenziali OAuth Web del tuo progetto Google.
# Consulta docs/Google-Calendar.html. Nessuna credenziale e distribuita.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
# Esempio locale: http://127.0.0.1:8765/api/calendar/google/callback
# Esempio VPS: https://gestionale.esempio.it/api/calendar/google/callback
